# Copia este archivo a .env y rellena los valores
# (docker-compose lee .env del mismo directorio automáticamente)

JWT_SECRET=tu_clave_hexadecimal_larga_minimo_64_caracteres
JWT_EXPIRATION=86400000

DB_NAME=users_db
DB_USER=postgres
DB_PASSWORD=postgres

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/azure
SPA_BASE_URL=http://localhost:4200

# Opcional: login con Google (si vacío, solo aparece el botón de Microsoft)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Dominio que recibe rol ADMIN al iniciar por Microsoft (vacío/desconocido = todos los que entren por Microsoft)
AZURE_ADMIN_DOMAIN=duocuc.cl